# Copy to .env to override config/environments/<TEST_ENV>.env on your machine.
# Real environment variables win over both.

# TEST_ENV=local
# EMI_CALCULATOR_URL=https://emicalculator.net/
# API_BASE_URL=http://localhost:3000/api/v1
# START_API_SERVER=true
# HEADLESS=false

# Self-healing demo with Claude (npm run test:healing:claude).
# With ANTHROPIC_API_KEY set it calls the Claude API; without it, it uses a
# logged-in Claude Code install (claude -p). HEALER_TRANSPORT forces either.
# ANTHROPIC_API_KEY=
# HEALER_TRANSPORT=cli
# HEALER_MODEL=claude-opus-5-5
