# Used when TEST_ENV is unset or TEST_ENV=local.
# Real environment variables and a git-ignored .env file take precedence over these values.

EMI_CALCULATOR_URL=https://emicalculator.net/

# The catalogue API under test. With START_API_SERVER=true the test run starts
# the API in-process on this URL's port, unless something already answers there.
API_BASE_URL=http://localhost:3000/api/v1
START_API_SERVER=true

HEADLESS=true
VIEWPORT=1366x900
ACTION_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=60000
STEP_TIMEOUT_MS=90000

# Abort requests to ad and analytics hosts on emicalculator.net. The ads load
# slowly and shift the layout, which is the main source of flakiness there.
BLOCK_ADS=true
